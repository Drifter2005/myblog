<article class="post-card">
  <div class="post-card-meta"><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'YYYY.MM.DD') %></time><span class="meta-divider">/</span><% if (post.categories.length) { %><span><%= post.categories.last().name %></span><% } else { %><span>随记</span><% } %></div>
  <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
  <p class="post-excerpt"><%= strip_html(post.excerpt || post.content).replace(/\s+/g, ' ').slice(0, 130) %><%= strip_html(post.excerpt || post.content).length > 130 ? '…' : '' %></p>
  <div class="post-card-bottom"><div class="post-tags"><% post.tags.limit(3).each(function(tag) { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><a class="read-post" href="<%= url_for(post.path) %>" aria-label="阅读 <%= post.title %>"><span>阅读全文</span><%- partial('icon', {name: 'arrow'}) %></a></div>
</article>
