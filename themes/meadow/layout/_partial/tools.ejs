<div class="glass-dock" id="glass-dock" role="group" aria-label="快捷工具，长按可拖动">
  <button class="dock-mobile-toggle dock-button" id="dock-toggle" type="button" aria-label="展开快捷工具" aria-expanded="false" aria-controls="dock-actions"><%- partial('icon', {name: 'menu'}) %></button>
  <nav class="dock-actions" id="dock-actions" aria-label="快捷导航">
    <a class="dock-button" href="<%= url_for('/') %>" aria-label="引导首页" data-tip="首页"><%- partial('icon', {name: 'home'}) %></a>
    <a class="dock-button" href="<%= url_for('/archives/') %>" aria-label="文章归档" data-tip="归档"><%- partial('icon', {name: 'book'}) %></a>
    <button class="dock-button" type="button" data-open-search aria-label="搜索文章" data-tip="搜索"><%- partial('icon', {name: 'search'}) %></button>
    <button class="dock-button" type="button" id="music-toggle" aria-label="打开音乐" aria-controls="music-panel" aria-expanded="false" data-tip="音乐"><%- partial('icon', {name: 'music'}) %></button>
    <button class="dock-button" type="button" data-back-top aria-label="回到顶部" data-tip="顶部"><%- partial('icon', {name: 'up'}) %></button>
    <button class="dock-button dock-grip" id="dock-grip" type="button" aria-label="长按拖动工具条；也可按方向键移动" data-tip="长按拖动"><%- partial('icon', {name: 'grip'}) %></button>
  </nav>
</div>
<div id="live-status" class="sr-only" role="status" aria-live="polite"></div>
<dialog id="search-dialog" class="search-dialog"><div class="dialog-heading"><h2>找一篇文章</h2><button class="icon-button" data-close-search type="button" aria-label="关闭搜索"><%- partial('icon', {name: 'close'}) %></button></div><label class="search-field"><%- partial('icon', {name: 'search'}) %><input id="search-input" type="search" placeholder="标题、内容，或一个关键词…" autocomplete="off" aria-label="搜索标题、内容与标签"></label><p class="search-status" id="search-status" role="status">输入关键词，找回一段记录。</p><div id="search-results" class="search-results"></div></dialog>
<section class="music-panel" id="music-panel" aria-label="音乐播放器" hidden><div class="music-heading"><span class="eyebrow">A LITTLE MUSIC</span><button id="music-close" class="icon-button" type="button" aria-label="关闭音乐面板"><%- partial('icon', {name: 'close'}) %></button></div><p class="music-title" id="music-title">一格格</p><p class="music-artist" id="music-artist">卫兰</p><div class="music-controls"><button id="music-prev" type="button" aria-label="上一首">←</button><button id="music-play" type="button" aria-label="播放音乐"><%- partial('icon', {name: 'play'}) %></button><button id="music-next" type="button" aria-label="下一首">→</button></div><label class="music-progress-label"><span class="sr-only">播放进度</span><input id="music-progress" type="range" min="0" max="100" value="0" step="0.1" aria-label="播放进度"></label><div class="music-times"><span id="music-elapsed">0:00</span><span id="music-duration">0:00</span></div><label class="music-volume">音量<input id="music-volume" type="range" min="0" max="1" value="0.45" step="0.05"></label><p id="music-status" role="status"></p><audio id="blog-audio" preload="none"></audio></section>
