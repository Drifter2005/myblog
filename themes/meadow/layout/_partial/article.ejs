<article class="article reading-panel" itemscope itemtype="https://schema.org/BlogPosting">
  <header class="article-header"><a class="quiet-link" href="<%= url_for('/#journal') %>">← 返回文章</a><div class="article-meta"><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'YYYY.MM.DD') %></time><% if (post.categories && post.categories.length) { %><span>/ <%= post.categories.last().name %></span><% } %><span>/ 约 <%= Math.max(1, Math.ceil(strip_html(post.content).length / 450)) %> 分钟</span></div><h1 itemprop="headline"><%= post.title %></h1><div class="post-tags"><% if (post.tags) { post.tags.each(function(tag) { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); } %></div></header>
  <% var articleContent = post.content || ''; var firstHeading = articleContent.match(/^\s*<h1\b[^>]*>([\s\S]*?)<\/h1>/i); function simpleTitle(value) { return strip_html(String(value)).replace(/[\s《》]/g, ''); } if (firstHeading && simpleTitle(firstHeading[1]) === simpleTitle(post.title)) articleContent = articleContent.slice(firstHeading[0].length); articleContent = articleContent.replace(/(<\/?)h1(?=[\s>])/gi, '$1h2'); %>
  <div class="article-entry" itemprop="articleBody"><%- articleContent %></div>
  <footer class="article-footer"><span>感谢你读到这里。</span><div><button class="like-btn" type="button" data-post="<%= url_for(post.path) %>" aria-label="喜欢这篇文章"><span class="like-icon" aria-hidden="true">♡</span><span class="like-count">0</span></button><button type="button" class="copy-link" data-copy-link>复制链接</button></div></footer>
</article>
<% if (post.prev || post.next) { %><nav class="article-pagination" aria-label="相邻文章"><% if (post.prev) { %><a href="<%= url_for(post.prev.path) %>"><small>← 上一篇</small><span><%= post.prev.title %></span></a><% } %><% if (post.next) { %><a href="<%= url_for(post.next.path) %>"><small>下一篇 →</small><span><%= post.next.title %></span></a><% } %></nav><% } %>
<% if (post.comments !== false && theme.waline && theme.waline.serverURL) { %><section id="comments" class="reading-panel comment-section"><h2>留言</h2><div id="waline"></div></section><% } %>
