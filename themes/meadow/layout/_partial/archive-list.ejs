<div class="archive-list"><% var year; page.posts.each(function(post) { var current = date(post.date, 'YYYY'); if (year !== current) { year = current; %><h2 class="archive-year"><%= year %></h2><% } %><a class="archive-row" href="<%= url_for(post.path) %>"><time datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'MM.DD') %></time><span><%= post.title %></span><span aria-hidden="true">↗</span></a><% }); %></div><%- partial('_partial/pagination') %>
