@import "nib"
@import "_variables"
@import "_util/mixin"
@import "_util/grid"

global-reset()

// nib 的 global-reset() 给所有元素 outline:0 —— 必须紧跟其后恢复键盘焦点可见性
:focus-visible
  outline: 2px solid rgba(116, 247, 209, 0.85)
  outline-offset: 2px

// 屏幕阅读器专用文本（pjax.js 会创建 .sr-only live region）
.sr-only
  position: absolute
  width: 1px
  height: 1px
  padding: 0
  margin: -1px
  overflow: hidden
  clip: rect(0, 0, 0, 0)
  clip-path: inset(50%)
  white-space: nowrap
  border: 0

// 跳到正文链接：默认移出视口，键盘聚焦时出现在左上角
.skip-link
  position: absolute
  top: 0
  left: -9999px
  z-index: 100
  padding: 10px 18px
  border-radius: 0 0 12px 0
  color: #071426
  background: #74f7d1
  font-weight: 700
  text-decoration: none
  &:focus-visible
    left: 0

// 高对比度模式下背景渐变会被清除，激活态需要 outline 兜底
@media (forced-colors: active)
  a:focus-visible,
  button:focus-visible,
  .main-nav-link:hover,
  .nav-icon:hover,
  .portal-action:hover,
  .article-more-link a:hover,
  .player-toggle:hover
    outline: 2px solid
    outline-offset: 2px

input, button
  margin: 0
  padding: 0
  &::-moz-focus-inner
    border: 0
    padding: 0

html, body, #container
  height: 100%

body
  background: color-background
  font: font-size font-sans
  -webkit-text-size-adjust: 100%

.outer
  clearfix()
  max-width: (column-width + gutter-width) * columns + gutter-width
  margin: 0 auto
  padding: 0 gutter-width

.inner
  column(columns)

.left, .alignleft
  float: left

.right, .alignright
  float: right

.clear
  clear: both

#container
  position: relative

.mobile-nav-on
  overflow: hidden

#wrap
  height: 100%
  width: 100%
  position: absolute
  top: 0
  left: 0
  transition: 0.2s ease-out
  z-index: 1
  background: color-background
  .mobile-nav-on &
    left: mobile-nav-width

if sidebar and sidebar isnt bottom
  #main
    @media mq-normal
      column(main-column)

if sidebar is left
  @media mq-normal
    #main
      float: right

@import "_extend"
