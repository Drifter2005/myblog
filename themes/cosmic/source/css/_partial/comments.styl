// ====== 文章页脚的指标条（阅读量 / 评论数）======

.article-footer
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: 14px

.article-metric,
.article-comment-link
  display: inline-flex
  align-items: center
  gap: 7px
  color: #9fb3d2
  font-family: font-mono
  font-size: 13px
  font-variant-numeric: tabular-nums
  text-decoration: none
  transition: color 0.25s ease

  .fa
    font-size: 12px
    opacity: 0.72

a.article-comment-link:hover
  color: #74f7d1
  text-decoration: none

  .fa
    opacity: 1

// 计数未回填时的占位符，避免数字跳入时的布局抖动
.waline-pageview-count,
.waline-comment-count
  display: inline-block
  min-width: 1.4em
  text-align: left


// ====== 评论区外壳 ======

// 大黑影与 backdrop-filter 已删：背景不透明度补偿 + 顶部受光边
.comment-section
  margin-top: 34px
  padding: 26px 28px 28px
  border: 1px solid rgba(116, 198, 255, 0.16)
  border-radius: 14px
  background: linear-gradient(145deg, rgba(8, 19, 38, 0.96), rgba(4, 9, 21, 0.92))
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05)

.comment-title
  margin: 0 0 22px
  color: #eef4fb
  font-size: 19px
  font-weight: 600
  letter-spacing: 0.02em

.comment-noscript
  margin: 0 0 18px
  color: #9fb3d2
  font-size: 14px
  line-height: 1.7


// ====== Waline 主题化 ======
// 变量名取自 @waline/client v3 的 dist/waline.css，未凭记忆猜写。

#waline
  --waline-theme-color: #74f7d1
  --waline-active-color: #8eb6ff

  --waline-color: #b7c5da
  --waline-bg-color: rgba(3, 11, 24, 0.42)
  --waline-bg-color-light: rgba(7, 18, 36, 0.56)
  --waline-bg-color-hover: rgba(116, 247, 209, 0.08)

  --waline-border-color: rgba(116, 198, 255, 0.18)
  --waline-border: 1px solid rgba(116, 198, 255, 0.18)
  --waline-box-shadow: none

  --waline-font-size: 15px
  --waline-info-color: #9fb3d2
  --waline-info-bg-color: rgba(7, 18, 36, 0.52)
  --waline-info-font-size: 12.5px

  --waline-code-bg-color: rgba(2, 6, 18, 0.62)
  --waline-bq-color: rgba(142, 182, 255, 0.34)

  --waline-badge-color: #f6d99d
  --waline-badge-font-size: 12px

  --waline-avatar-radius: 50%
  --waline-disable-bg-color: rgba(7, 18, 36, 0.4)
  --waline-disable-color: #6f819c

  // Waline 自带暗色变量走 dark: 'html'，这里只补主题色调
  color: #b7c5da

  // 输入区与按钮贴合本站语言
  .wl-panel
    border-radius: 10px
    background: rgba(3, 11, 24, 0.46)

  .wl-btn
    border-radius: 999px
    transition: all 0.2s ease

  .wl-btn.primary
    color: #071426
    border-color: transparent
    background: linear-gradient(90deg, #74f7d1, #8eb6ff)

    &:hover
      background: linear-gradient(90deg, #f6d99d, #74f7d1)
      transform: translateY(-1px)

  .wl-editor
    border-radius: 10px

  // reaction（充当「赞」）—— 让它在深色背景下有足够对比
  .wl-reaction-item
    transition: transform 0.18s ease

    &:hover
      transform: translateY(-1px)

  .wl-reaction-votes
    color: #74f7d1
    font-variant-numeric: tabular-nums

  a
    color: #74f7d1

    &:hover
      color: #8eb6ff


@media screen and (max-width: 479px)
  .comment-section
    padding: 20px 18px 22px

  .article-footer
    gap: 12px
