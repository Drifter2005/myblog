// ====== 点赞系统样式 ======

.article-like
  display: inline-block
  margin-top: 20px
  margin-left: 10px

.like-btn
  display: inline-flex
  align-items: center
  gap: 8px
  padding: 8px 14px
  border: 1px solid rgba(116, 247, 209, 0.28)
  border-radius: 999px
  background: rgba(116, 247, 209, 0.08)
  color: #dcecff
  font-size: 14px
  font-weight: 600
  cursor: pointer
  transition: all 0.32s cubic-bezier(0.2, 0.8, 0.2, 1)
  white-space: nowrap
  user-select: none

  &:hover
    border-color: rgba(116, 247, 209, 0.46)
    background: rgba(116, 247, 209, 0.16)
    transform: translateY(-2px)
    box-shadow: 0 8px 24px rgba(116, 247, 209, 0.12)

  &.liked
    background: linear-gradient(90deg, #ff6b6b, #ff8787)
    border-color: #ff8787
    color: #fff

    .like-icon
      animation: likeHeartBeat 0.6s ease-out

  &.has-likes
    background: rgba(255, 107, 107, 0.12)
    border-color: rgba(255, 107, 107, 0.28)

  .like-icon
    font-size: 16px
    display: inline-block

  .like-count
    font-weight: 700
    min-width: 20px
    text-align: center

.article-footer
  display: flex
  align-items: center
  flex-wrap: wrap
  gap: 12px

@keyframes likeHeartBeat
  0%
    transform: scale(1)
  14%
    transform: scale(1.3)
  28%
    transform: scale(1)
  42%
    transform: scale(1.3)
  70%
    transform: scale(1)

// ====== 评论区域优化 ======

.vcomment
  margin-top: 40px
  padding-top: 30px
  border-top: 1px solid rgba(116, 247, 209, 0.16)

.comment-section
  background: rgba(7, 18, 36, 0.62)
  border: 1px solid rgba(116, 198, 255, 0.16)
  border-radius: 24px
  padding: 24px
  margin-top: 30px
  backdrop-filter: blur(12px)

.comment-title
  color: #f4fbff
  font-size: 18px
  font-weight: 600
  margin-bottom: 20px
  display: flex
  align-items: center
  gap: 10px

  &:before
    content: "💬"
    font-size: 20px

@media screen and (max-width: 479px)
  .article-like
    margin-top: 15px
    margin-left: 0

  .like-btn
    font-size: 13px
    padding: 7px 12px
