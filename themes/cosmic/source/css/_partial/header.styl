#header
  height: banner-height
  position: relative
  border-bottom: 1px solid color-border
  &:before, &:after
    content: ""
    position: absolute
    left: 0
    right: 0
    height: 40px
  &:before
    top: 0
    background: linear-gradient(rgba(0, 0, 0, 0.2), transparent)
  &:after
    bottom: 0
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.2))

#header-outer
  height: 100%
  position: relative

#header-inner
  position: relative
  overflow: hidden

#banner
  position: absolute
  top: 0
  left: 0
  width: 100%
  height: 100%
  background: url(banner-url) center #000
  background-size: cover
  z-index: -1

#header-title
  text-align: center
  height: logo-size
  position: absolute
  top: 50%
  left: 0
  margin-top: logo-size * -0.5

$logo-text
  text-decoration: none
  color: #fff
  font-weight: 300
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3)

#logo
  @extend $logo-text
  font-size: logo-size
  line-height: logo-size
  letter-spacing: 2px

#subtitle
  @extend $logo-text
  font-size: subtitle-size
  line-height: subtitle-size
  letter-spacing: 1px

#subtitle-wrap
  margin-top: subtitle-size

#main-nav
  float: left
  margin-left: -15px

$nav-link
  float: left
  color: #fff
  opacity: 0.65
  text-decoration: none
  text-shadow: 0 1px rgba(0, 0, 0, 0.2)
  transition: opacity 0.2s ease, text-shadow 0.2s ease
  display: block
  padding: 20px 16px
  position: relative
  &:hover
    opacity: 1
    text-shadow: 0 0 12px rgba(116, 247, 209, 0.4)

.nav-icon
  @extend $nav-link
  text-align: center
  font-size: font-size
  width: font-size
  height: font-size
  padding: 20px 15px
  position: relative
  cursor: pointer

// #main-nav-toggle 与 .nav-search-btn 已从 <a> 改为 <button>：
// 重置 UA 按钮外观；content-box 保持与原 <a> 相同的盒模型尺寸
button.nav-icon
  appearance: none
  box-sizing: content-box
  border: 0
  background: transparent

.main-nav-link
  @extend $nav-link
  font-weight: 300
  letter-spacing: 1px
  @media mq-mobile
    display: none

#main-nav-toggle
  display: none
  @media mq-mobile
    display: block

#sub-nav
  float: right
  margin-right: -15px

#search-form-wrap
  position: absolute
  top: 15px
  width: 160px
  height: 32px
  right: -160px
  opacity: 0
  transition: opacity 0.28s cubic-bezier(0.2, 0.8, 0.2, 1), right 0.28s cubic-bezier(0.2, 0.8, 0.2, 1)
  &.on
    opacity: 1
    right: 0
  @media mq-mobile
    width: 100%
    right: -100%
    height: 40px
    top: 10px

// backdrop-filter 已删：输入框走不透明深底，保证 banner 上可读
.search-form
  position: absolute
  top: 0
  left: 0
  right: 0
  background: rgba(4, 11, 23, 0.92)
  padding: 6px 16px
  border-radius: 999px
  border: 1px solid rgba(116, 247, 209, 0.22)
  transition: background 0.2s ease, border-color 0.2s ease
  &:hover,
  &:focus-within
    background: rgba(7, 18, 36, 0.96)
    border-color: rgba(116, 247, 209, 0.34)

.search-form-input
  border: none
  background: none
  color: #c9d7ea
  width: 100%
  font: 14px font-sans
  outline: none
  &::placeholder
    color: rgba(201, 215, 234, 0.5)
  &::-webkit-search-results-decoration
  &::-webkit-search-cancel-button
    -webkit-appearance: none

.search-form-submit
  position: absolute
  top: 50%
  right: 14px
  margin-top: -8px
  font: 14px font-icon
  border: none
  background: none
  color: #74f7d1
  cursor: pointer
  transition: color 0.25s ease
  &:hover
    color: #8eb6ff