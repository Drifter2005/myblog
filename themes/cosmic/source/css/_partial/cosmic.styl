// Cosmic observatory skin for Drifter Observatory.
html
  scroll-behavior: smooth
  scroll-padding-top: 80px

// 灰阶层级（可排序，1.8×/1.6× 步长）：
//   标题 #eef4fb ≈15:1 ｜ 正文 #b7c5da ≈8.4:1 ｜ 次要 #8fa3c0 ≈5.2:1
:root
  // 正文行长：34em = 34 汉字 ≈ 68 拉丁，作者可调 36em / 38em
  --measure: 34em

body
  color: #b7c5da
  background:
    radial-gradient(circle at 18% 12%, rgba(75, 124, 255, 0.22), transparent 32%),
    radial-gradient(circle at 84% 18%, rgba(116, 247, 209, 0.14), transparent 26%),
    radial-gradient(circle at 58% 72%, rgba(255, 188, 117, 0.10), transparent 34%),
    linear-gradient(135deg, #030611 0%, #071426 45%, #02040b 100%)
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen", "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue", sans-serif
  overflow-x: hidden
  -webkit-font-smoothing: antialiased
  -moz-osx-font-smoothing: grayscale
  &:before
    content: ""
    position: fixed
    inset: 0
    pointer-events: none
    z-index: 0
    background-image:
      radial-gradient(circle, rgba(255,255,255,0.68) 0 1px, transparent 1.5px),
      radial-gradient(circle, rgba(116,247,209,0.42) 0 1px, transparent 1.4px)
    background-size: 120px 120px, 210px 210px
    background-position: 0 0, 44px 72px
    opacity: 0.38
  &:after
    content: ""
    position: fixed
    inset: 0
    pointer-events: none
    z-index: 0
    background: linear-gradient(transparent 0, rgba(116, 198, 255, 0.032) 50%, transparent 100%)
    background-size: 100% 6px
    mix-blend-mode: screen

#container
  z-index: 1

#wrap
  min-height: 100%
  height: auto
  background: transparent

.cosmic-background
  position: fixed
  inset: 0
  overflow: hidden
  pointer-events: none
  z-index: 0

.cosmic-orbit
  position: absolute
  border: 1px solid rgba(116, 198, 255, 0.16)
  border-radius: 50%
  box-shadow: 0 0 70px rgba(116, 247, 209, 0.08), inset 0 0 60px rgba(116, 198, 255, 0.06)
  transform: rotate(-18deg)

.orbit-alpha
  width: 720px
  height: 260px
  left: -160px
  top: 120px

.orbit-beta
  width: 920px
  height: 340px
  right: -360px
  top: 460px

.orbit-gamma
  width: 520px
  height: 190px
  left: 30%
  bottom: -80px

#header
  // masthead 收敛：从 58vh/430px 收到桌面 ≤320px（正文更早进入首屏）
  min-height: 260px
  height: unquote("min(38vh, 320px)")
  border-bottom: 1px solid rgba(116, 247, 209, 0.26)
  box-shadow: inset 0 -100px 140px rgba(5, 9, 21, 0.82)
  overflow: hidden
  &:before
    height: 100%
    background:
      radial-gradient(circle at 50% 42%, rgba(116, 247, 209, 0.16), transparent 24%),
      linear-gradient(rgba(1, 4, 14, 0.32), rgba(1, 4, 14, 0.82))
  &:after
    height: 46%
    background: linear-gradient(transparent, rgba(5, 9, 21, 0.96))

#banner
  background:
    radial-gradient(circle at 50% 46%, rgba(116, 247, 209, 0.16), transparent 10%),
    radial-gradient(circle at 28% 35%, rgba(87, 119, 255, 0.28), transparent 18%),
    radial-gradient(circle at 74% 24%, rgba(255, 210, 130, 0.14), transparent 16%),
    linear-gradient(145deg, #020616, #071a34 48%, #03050d)
  filter: saturate(1.16)

.cosmic-grid
  position: absolute
  inset: 0
  z-index: 0
  background-image:
    linear-gradient(rgba(116, 198, 255, 0.09) 1px, transparent 1px),
    linear-gradient(90deg, rgba(116, 198, 255, 0.09) 1px, transparent 1px)
  background-size: 64px 64px
  -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.65), transparent 75%)
  mask-image: linear-gradient(to bottom, rgba(0,0,0,0.65), transparent 75%)

.cosmic-scanline
  position: absolute
  left: 0
  right: 0
  bottom: 18%
  height: 1px
  background: linear-gradient(90deg, transparent, rgba(116,247,209,0.76), transparent)
  box-shadow: 0 0 28px rgba(116,247,209,0.56)
  z-index: 2

#header-title
  top: 47%
  transform: translateY(-50%)
  margin-top: 0

.hero-kicker
  display: inline-block
  margin-bottom: 18px
  padding: 8px 14px
  border: 1px solid rgba(116, 247, 209, 0.28)
  border-radius: 999px
  color: #74f7d1
  font-family: font-mono
  font-size: 12px
  letter-spacing: 0.24em
  background: rgba(4, 11, 23, 0.62)
  box-shadow: 0 0 24px rgba(116, 247, 209, 0.12)

#logo
  color: #eef4fb
  font-size: clamp(30px, 5vw, 44px)
  // header.styl 的 line-height 按 40px 字号写死，这里字号放大后必须同步，
  // 否则标题换行时字形重叠。
  line-height: 1.15
  font-weight: 700
  letter-spacing: 0.08em
  text-transform: uppercase
  text-shadow: 0 0 24px rgba(116, 247, 209, 0.45), 0 10px 40px rgba(0,0,0,0.82)

#subtitle
  color: #b8c9e6
  font-size: 18px
  line-height: 1.5
  // 副标题是中文：字距归零（0.18em 会把汉字拆散）
  letter-spacing: 0
  text-shadow: 0 0 16px rgba(116, 198, 255, 0.35)

.hero-metrics
  display: flex
  justify-content: center
  flex-wrap: wrap
  gap: 10px
  margin-top: 26px
  span
    padding: 7px 12px
    border: 1px solid rgba(116, 198, 255, 0.22)
    border-radius: 6px
    color: #b7c5da
    background: rgba(4, 11, 23, 0.56)
    font-family: font-mono
    font-size: 12px

.nav-icon,
.main-nav-link
  color: #dcecff
  opacity: 0.78
  font-family: font-mono
  &:hover
    color: #74f7d1
    opacity: 1
    text-decoration: none

.nav-icon
  text-transform: uppercase
  letter-spacing: 0.08em

// 菜单标签是中文（首页/算法星图/…）：中文字距一律归零，
// font-mono 已带 CJK 回退，不会落到宋体。
.main-nav-link
  text-transform: none
  letter-spacing: 0

.outer
  max-width: 1180px

#main
  position: relative
  z-index: 2

.article
  margin: 36px 0

// 卡片层次 = 背景明度台阶 + 1px 边框 + 顶部受光边（不再用大黑影与 backdrop-filter）
.article-inner
  border: 1px solid rgba(116, 198, 255, 0.16)
  border-radius: 14px
  background: linear-gradient(145deg, rgba(10, 21, 38, 0.96), rgba(6, 13, 26, 0.94))
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05)

.article-meta
  margin-left: 18px

.article-signal
  float: left
  margin-right: 10px
  padding: 6px 10px
  border-radius: 999px
  color: #071426
  background: linear-gradient(90deg, #74f7d1, #8eb6ff)
  font-family: font-mono
  font-size: 11px
  font-weight: 700
  letter-spacing: 0.16em

.article-title
  color: #eef4fb
  font-size: 2.18em
  letter-spacing: 0.01em
  font-weight: 600
  line-height: 1.32
  transition: color 0.28s ease
  a&:hover
    color: #74f7d1
    text-shadow: 0 0 20px rgba(116, 247, 209, 0.38)

.article-entry
  color: #b7c5da
  font-size: 16px
  line-height: 1.88
  word-break: break-word
  // 中文严格断行：避头尾字符不落行首/行尾
  line-break: strict
  h1, h2, h3, h4, h5, h6
    color: #eef4fb
    margin-top: 1.6em
    margin-bottom: 0.8em
    font-weight: 600
  h1
    font-size: 1.8em
  h2
    border-left: 2px solid rgba(116, 247, 209, 0.55)
    padding-left: 16px
    font-size: 1.5em
  h3
    font-size: 1.25em
  // 段距 24px < 行距 ~30px：段落才能成组（article.styl 的 1.65em 上下距被覆盖）
  p
    margin: 0 0 24px
    line-height: inherit
  ul, ol
    margin: 0 0 24px
    padding-left: 1.7em
  ul ul, ol ol, ul ol, ol ul
    margin: 0.3em 0
  dl
    margin: 0 0 24px
  // 链接：与正文同色系 + 常态下划线（WCAG 1.4.1 的非颜色区分，不可改成纯色）
  a
    color: #b7e3d4
    text-decoration: underline
    text-decoration-thickness: 1px
    text-underline-offset: 0.22em
    // under + 关掉 skip-ink：下划线避开中文横画，且不在「口/日/四」上打断口
    text-underline-position: under
    text-decoration-skip-ink: none
    transition: color 0.2s ease
    &:hover
      color: #74f7d1
      text-decoration-thickness: 2px
  // 中文强调走亮度（无 roman/italic 形态轴，YaHei 无 500 时落回 400，仍有亮度差）
  strong
    color: #eef4fb
    font-weight: 500
  em
    font-style: normal
    color: #8fa3c0
  blockquote
    border-left: 3px solid #8eb6ff
    margin: 28px 0
    padding: 14px 20px
    text-align: left
    background: rgba(142, 182, 255, 0.06)
    border-radius: 0 10px 10px 0
    color: #b8c9e6
    // 中文没有斜体传统，合成斜体难看
    font-style: normal
  code
    color: #74f7d1
    background: rgba(116, 247, 209, 0.08)
    border: 1px solid rgba(116, 247, 209, 0.14)
    border-radius: 6px
    padding: 0.15em 0.4em
    font-size: 0.95em
  table
    overflow: hidden
    border-radius: 10px
    border: 1px solid rgba(116, 198, 255, 0.14)
    width: 100%
    table-layout: auto
  th
    color: #eef4fb
    background: linear-gradient(135deg, rgba(116, 198, 255, 0.12), rgba(142, 182, 255, 0.08))
    font-weight: 600
  td, th
    padding: 13px 14px
    border-bottom: 1px solid rgba(116, 198, 255, 0.1)
  img
    border-radius: 10px
    max-width: 100%
    height: auto

.article-more-link a
  display: inline-block
  color: #071426
  background: linear-gradient(90deg, #74f7d1, #8eb6ff)
  text-shadow: none
  font-weight: 600
  padding: 10px 20px
  border-radius: 999px
  transition: background 0.18s ease, transform 0.18s ease
  text-decoration: none
  &:hover
    background: linear-gradient(90deg, #f6d99d, #74f7d1)
    color: #071426
    transform: translateY(-1px)

.article-footer
  border-top: 1px solid rgba(116, 198, 255, 0.15)
  a
    color: #8eb6ff
    &:hover
      color: #74f7d1

.article-tag-list-link:before
  color: #74f7d1

.widget-wrap
  border: 1px solid rgba(116, 198, 255, 0.14)
  border-radius: 14px
  background: rgba(7, 18, 36, 0.9)
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05)
  transition: border-color 0.2s ease
  &:hover
    border-color: rgba(116, 247, 209, 0.24)

.widget-title
  color: #eef4fb
  border-bottom: 1px solid rgba(116, 247, 209, 0.18)
  font-family: font-mono
  // 标题主文案是中文（归档/分类/…）：字距归零；内部拉丁角标 span 单独保留字距
  letter-spacing: 0
  font-weight: 600
  transition: color 0.3s ease

.widget a
  color: #a9bbd9
  &:hover
    color: #74f7d1

.archive-article
  border-left: 1px solid rgba(116, 198, 255, 0.16)
  padding-left: 18px

#footer
  margin-top: 64px
  padding-top: 40px
  padding-bottom: 40px
  color: #8ea0bd
  background: linear-gradient(180deg, rgba(1, 5, 14, 0.84), rgba(1, 5, 14, 0.92))
  border-top: 1px solid rgba(116, 247, 209, 0.14)
  font-size: 14px
  line-height: 1.6
  a
    color: #74f7d1
    transition: color 0.25s ease
    &:hover
      color: #8eb6ff

.highlight
  border-radius: 10px
  overflow: hidden
  border: 1px solid rgba(116, 247, 209, 0.12)
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.03)
  background: rgba(2, 6, 18, 0.5) !important
  line-height: 1.6
  code
    background: transparent !important
    border: none !important
    padding: 0 !important
    color: inherit !important

@media screen and (max-width: 479px)
  .hero-kicker
    font-size: 10px
    letter-spacing: 0.14em
  .article-title
    font-size: 1.68em
    line-height: 1.28
  .article-entry
    font-size: 15px
    line-height: 1.82
  .portal-landing
    padding: 24px
  .guide-card summary
    min-height: 130px
    padding: 18px

// === Dynamic cosmic layer start ===
:root
  --cosmic-mouse-x: 50vw
  --cosmic-mouse-y: 50vh
  --cosmic-parallax-x: 0px
  --cosmic-parallax-y: 0px

#starfield
  position: fixed
  inset: 0
  width: 100vw
  height: 100vh
  pointer-events: none
  z-index: 0
  opacity: 0.9
  mix-blend-mode: screen

// 定位由 JS 直接写 transform（走合成器，不触发样式失效），
// margin 负值负责把圆心对到光标上。
.cursor-halo
  position: fixed
  left: 0
  top: 0
  width: 400px
  height: 400px
  margin-left: -200px
  margin-top: -200px
  pointer-events: none
  z-index: 1
  border-radius: 50%
  background: radial-gradient(circle, rgba(116,247,209,0.16), rgba(142,182,255,0.07) 38%, transparent 68%)
  filter: blur(10px)
  opacity: 0
  transition: opacity 0.32s ease
  will-change: opacity, transform

body.cosmic-pointer-active .cursor-halo
  opacity: 0.9

// transform 由 JS 直接写入（视差跟随），CSS 只保留过渡
.cosmic-background
  transition: transform 0.14s ease-out

// 无限动画全部移除（orbitBreath / nebulaDrift / gridDrift / scanPulse /
// spectralSweep / portalSweep / radarSpin）：nebulaDrift 的 hue-rotate
// 让全站对比度不可认证；其余是纯装饰性常驻合成负担。
// 一次性入场动画（logoIgnition / chipRise / in-view）保留。
.cosmic-scanline
  opacity: 0.4

#logo
  position: relative
  display: inline-block

body.cosmic-ready #logo
  animation: logoIgnition 1.1s ease both

.hero-metrics span
  opacity: 0
  transform: translateY(12px)
  animation: chipRise 0.72s cubic-bezier(.2,.8,.2,1) forwards
  &:nth-child(1)
    animation-delay: 0.18s
  &:nth-child(2)
    animation-delay: 0.3s
  &:nth-child(3)
    animation-delay: 0.42s
  &:nth-child(4)
    animation-delay: 0.54s

// 入场：去 scale（非整数缩放让中文字形重栅格化发糊），位移 12px，0.4s
.article,
.widget-wrap
  opacity: 0
  transform: translateY(12px)
  transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
              transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
              border-color 0.2s ease

.article.in-view,
.widget-wrap.in-view
  opacity: 1
  transform: translateY(0)

.article-inner
  position: relative
  overflow: hidden
  transition: transform 0.18s ease,
              border-color 0.18s ease

// hover 只走边框提亮 + 1px 位移，不再有大黑影/光斑/掠光
.article-inner:hover
  transform: translateY(-1px)
  border-color: rgba(116, 247, 209, 0.44)

.main-nav-link
  position: relative
  transition: color 0.2s ease
  &:after
    content: ""
    position: absolute
    left: 14px
    right: 14px
    bottom: 11px
    height: 2px
    background: linear-gradient(90deg, transparent, #74f7d1, transparent)
    transform: scaleX(0)
    transform-origin: center
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1)
  &:hover
    color: #74f7d1
  &:hover:after
    transform: scaleX(1)

// （SIGNAL TRACE 角标已删：选择器命中嵌套结构时每块渲染 3 个，且压行号。
//  代码块的 margin 收进 highlight.styl 的 $code-block。）

@keyframes logoIgnition
  from
    opacity: 0
    transform: translateY(14px) scale(0.96)
    letter-spacing: 0.18em
    filter: blur(6px)
  to
    opacity: 1
    transform: translateY(0) scale(1)
    letter-spacing: 0.08em
    filter: blur(0)

@keyframes chipRise
  from
    opacity: 0
    transform: translateY(16px)
  to
    opacity: 1
    transform: translateY(0)

// reduced-motion 走白名单：明确列出要停的入场/装饰动画。
// 不做 * 毯子（那会杀死 APlayer 进度条的 transition，播放器看起来卡死），
// .aplayer 内部一律不碰；播放器自身的例外写在 player.styl。
@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior: auto
  #starfield,
  .cursor-halo
    display: none
  .article,
  .widget-wrap
    opacity: 1
    transform: none
    transition: none
  .hero-metrics span
    animation: none
    opacity: 1
    transform: none
  body.cosmic-ready #logo
    animation: none
  .cosmic-background
    transition: none

html.loading
  body
    &:before,
    &:after
      opacity: 0.8

body.cosmic-ready
  .loading-bar
    animation: loadingComplete 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards

@keyframes loadingComplete
  from
    width: 100%
    opacity: 1
  to
    width: 100%
    opacity: 0
    pointer-events: none

// === Dynamic cosmic layer end ===

// === Portal guide and sidebar upgrade start ===
// 鼠标跟随光效已由 .cursor-halo（合成器层）承担，
// body 背景不再引用鼠标变量 —— 那会随 pointermove 反复重绘整页背景。
body
  background:
    radial-gradient(circle at 10% 8%, rgba(67, 103, 255, 0.34), transparent 24rem),
    radial-gradient(circle at 88% 20%, rgba(0, 255, 194, 0.18), transparent 20rem),
    radial-gradient(circle at 56% 86%, rgba(255, 177, 92, 0.13), transparent 24rem),
    linear-gradient(145deg, #01030b 0%, #04111f 38%, #020510 68%, #000208 100%)

#wrap
  background:
    linear-gradient(90deg, rgba(116,247,209,0.04) 1px, transparent 1px),
    linear-gradient(rgba(116,247,209,0.035) 1px, transparent 1px)
  background-size: 72px 72px

.portal-landing
  position: relative
  display: grid
  grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr)
  gap: 32px
  align-items: center
  margin: -8px 0 34px
  padding: 34px
  overflow: hidden
  border: 1px solid rgba(116,247,209,0.20)
  border-radius: 14px
  background:
    radial-gradient(circle at 20% 0%, rgba(116,247,209,0.16), transparent 34%),
    linear-gradient(135deg, rgba(7, 22, 43, 0.96), rgba(2, 7, 18, 0.92))
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06)
  transition: border-color 0.2s ease

.portal-panel
  position: relative
  z-index: 2

.portal-eyebrow
  display: inline-flex
  margin: 0 0 16px
  padding: 8px 13px
  border: 1px solid rgba(116,247,209,0.34)
  border-radius: 999px
  color: #74f7d1
  background: rgba(4,14,28,0.78)
  font: 700 11px font-mono
  letter-spacing: 0.2em
  text-transform: uppercase

.portal-panel h1
  margin: 0
  color: #eef4fb
  font-size: clamp(34px, 5vw, 66px)
  line-height: 1.12
  // 中文大标题：字距归零
  letter-spacing: 0
  text-shadow: 0 0 32px rgba(116,247,209,0.22)

.portal-copy
  max-width: 690px
  margin: 20px 0 0
  color: #b7c5da
  font-size: 17px
  line-height: 1.9

.portal-actions
  display: flex
  flex-wrap: wrap
  gap: 12px
  margin-top: 26px

.portal-action
  display: inline-flex
  align-items: center
  justify-content: center
  min-height: 42px
  padding: 0 18px
  border: 1px solid rgba(142,182,255,0.28)
  border-radius: 999px
  color: #dcecff
  background: rgba(7,18,36,0.72)
  font: 700 13px font-mono
  // 按钮文案是中文（启动算法星图/…）：字距归零
  letter-spacing: 0
  text-decoration: none
  transition: transform 0.18s ease, border-color 0.18s ease, color 0.18s ease, background 0.18s ease
  &:hover
    color: #071426
    border-color: transparent
    background: linear-gradient(90deg, #74f7d1, #8eb6ff)
    transform: translateY(-1px)
    text-decoration: none

.portal-action.primary
  color: #071426
  background: linear-gradient(90deg, #74f7d1, #f6d99d)
  border-color: transparent

// 雷达缩到 180px，扫描束改为静态 conic-gradient（radarSpin 已删）
.portal-radar
  position: relative
  z-index: 2
  min-height: 180px
  border-radius: 50%

.radar-ring,
.radar-sweep,
.radar-core
  position: absolute
  left: 50%
  top: 50%
  transform: translate(-50%, -50%)
  border-radius: 50%

.radar-ring
  border: 1px solid rgba(116,247,209,0.28)
  box-shadow: inset 0 0 34px rgba(116,247,209,0.08)

.ring-one
  width: 56px
  height: 56px

.ring-two
  width: 116px
  height: 116px

.ring-three
  width: 180px
  height: 180px

.radar-sweep
  width: 180px
  height: 180px
  background: conic-gradient(from 0deg, rgba(116,247,209,0.42), rgba(116,247,209,0.05), transparent 26%)

.radar-core
  width: 18px
  height: 18px
  background: #f6d99d
  box-shadow: 0 0 26px rgba(246,217,157,0.85)

.mission-grid
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 18px
  margin: 0 0 40px

.guide-grid
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 18px
  margin: 0 0 40px

.guide-card
  border: 1px solid rgba(116,198,255,0.18)
  border-radius: 14px
  background: linear-gradient(145deg, rgba(9,23,45,0.96), rgba(3,9,21,0.92))
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05)
  overflow: hidden
  transition: border-color 0.2s ease, transform 0.18s ease
  &:hover
    border-color: rgba(116,247,209,0.40)
    transform: translateY(-1px)
  &[open]
    grid-column: span 1
    border-color: rgba(116,247,209,0.52)

.guide-card summary
  display: flex
  align-items: center
  gap: 14px
  min-height: 142px
  padding: 22px
  cursor: pointer
  list-style: none
  &::-webkit-details-marker
    display: none

.guide-card-index
  color: #74f7d1
  font: 700 12px font-mono
  letter-spacing: 0.16em

.guide-card-heading
  flex: 1
  strong, small
    display: block
  strong
    color: #eef4fb
    font-size: 22px
  small
    margin-top: 9px
    color: #a9bbd9
    line-height: 1.6

.guide-card-toggle
  color: #74f7d1
  font-size: 28px
  line-height: 1
  transition: transform 0.2s ease

.guide-card[open] .guide-card-toggle
  transform: rotate(45deg)

.guide-card-body
  padding: 0 22px 22px 54px
  color: #b7c5da
  line-height: 1.75
  border-top: 1px solid rgba(116,198,255,0.12)
  p
    margin: 18px 0

.guide-card-link
  display: inline-block
  color: #071426
  background: linear-gradient(90deg, #74f7d1, #8eb6ff)
  border-radius: 999px
  padding: 8px 14px
  font: 700 12px font-mono
  text-decoration: none

.article-summary
  display: block
  .article-meta
    margin-left: 18px

.article-preview
  max-height: 168px
  overflow: hidden
  mask-image: linear-gradient(to bottom, #000 72%, transparent)

.post-wide-shell
  max-width: 1060px
  margin: 0 auto
  .article-inner
    border-radius: 14px
  .article-entry
    font-size: 17px

.page-layout-post
  .outer
    max-width: 1180px
  .article
    opacity: 1
    transform: none
  #main
    float: none
    width: 100%
    max-width: 1080px
    margin: 0 auto
  #sidebar
    display: none
  .post-wide-shell
    max-width: 100%
  .article
    margin-top: 28px
  .article-inner
    overflow: visible
  .article-header
    padding: 34px 44px 0
  .article-title
    font-size: 2.28em
    line-height: 1.22
  // 34em 受限行长：grid 三列居中（--measure 可调）。
  // 三个必须项：min-width:0（防长代码行撑破整列）、
  // :before/:after content:none（干掉 nib clearfix() 注入的空 grid item）、
  // unquote()（Stylus 内置 min() 会静默吃掉 CSS min()）。
  .article-entry
    display: grid
    grid-template-columns: unquote("1fr min(var(--measure, 34em), 100%) 1fr")
    padding: 0 44px 36px
    font-size: 18px
    line-height: 1.9
    word-break: break-word
    > *
      grid-column: 2
      min-width: 0
    &:before,
    &:after
      content: none
    // 代码块与表格越界到宽列
    // box-sizing 必须显式 border-box：主题无全局 border-box，
    // 否则 width:100% + 代码块自身 padding 会溢出 grid 区域
    > .highlight,
    > pre,
    > table
      grid-column: 1 / -1
      width: 100%
      max-width: unquote("min(52em, 100%)")
      justify-self: center
      box-sizing: border-box
  .article-entry pre,
  .article-entry .highlight
    margin-left: 0
    margin-right: 0
    overflow-x: auto
  .article-entry .highlight table
    table-layout: auto
  .article-entry .highlight .code
    min-width: 0
  .article-entry .highlight .line
    white-space: pre
  .article-footer
    margin-left: 34px
    margin-right: 34px

@media screen and (max-width: 767px)
  .page-layout-post
    .article-header
      padding: 24px 22px 0
    .article-title
      font-size: 1.82em
    .article-entry
      padding: 0 22px 28px
      font-size: 16px
    #article-nav
      padding: 0 12px

.guide-page
  max-width: 1060px
  margin: 38px auto

.guide-page-header,
.guide-posts
  padding: 30px
  border: 1px solid rgba(116,198,255,0.2)
  border-radius: 14px
  background: linear-gradient(145deg, rgba(8,19,38,0.96), rgba(4,9,21,0.92))
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05)

// 栏目页正文（layout: guide 的 page.content）：global-reset 后所有内容
// 元素都是裸样式，这里补一套与 .article-entry 一致的内容排版。
.guide-page-copy
  color: #b7c5da
  font-size: 16px
  line-height: 1.85
  word-break: break-word
  line-break: strict
  // 段距 24px < 行距 ~30px：段落成组
  p
    margin: 0 0 24px
  ul, ol
    margin: 0 0 24px
    padding-left: 1.7em
  ul
    list-style: disc
  ol
    list-style: decimal
  ul ul, ol ol, ul ol, ol ul
    margin-top: 0.3em
    margin-bottom: 0.3em
  li
    margin: 0.4em 0
  // 与 .article-entry 一致：同色系 + 常态下划线（WCAG 1.4.1，不可改成纯颜色区分）
  a
    color: #b7e3d4
    text-decoration: underline
    text-decoration-thickness: 1px
    text-underline-offset: 0.22em
    text-underline-position: under
    text-decoration-skip-ink: none
    transition: color 0.2s ease
    &:hover
      color: #74f7d1
      text-decoration-thickness: 2px
  // 中文强调走亮度
  strong
    color: #eef4fb
    font-weight: 500
  em
    color: #8fa3c0
    font-style: normal
  h2, h3, h4
    color: #eef4fb
    margin: 1.6em 0 0.7em
    font-weight: 600
  h2
    font-size: 1.5em
    border-left: 2px solid rgba(116, 247, 209, 0.55)
    padding-left: 14px
  h3
    font-size: 1.25em
  h4
    font-size: 1.1em
  code
    color: #74f7d1
    background: rgba(116, 247, 209, 0.08)
    border: 1px solid rgba(116, 247, 209, 0.14)
    border-radius: 6px
    padding: 0.15em 0.4em
    font-family: font-mono
    font-variant-ligatures: none
    font-feature-settings: "calt" 0, "liga" 0
    font-size: 0.95em
  pre, .highlight
    margin: 20px 0
    padding: 15px article-padding
    border: 1px solid color-border
    border-radius: 10px
    background: rgba(2, 6, 18, 0.62)
    overflow: auto
    color: #cccccc
    font-family: font-mono
    font-variant-ligatures: none
    font-feature-settings: "calt" 0, "liga" 0
    line-height: 1.7
    code
      color: inherit
      background: transparent
      border: none
      padding: 0
  .highlight
    pre
      margin: 0
      padding: 0
      border: none
      background: transparent
    table, td, th
      margin: 0
      border: none
      padding: 0
      background: transparent
    .gutter pre
      color: #8fa3c0
      text-align: right
      padding-right: 16px
      user-select: none
  blockquote
    border-left: 3px solid #8eb6ff
    margin: 24px 0
    padding: 12px 18px
    background: rgba(142, 182, 255, 0.06)
    border-radius: 0 10px 10px 0
    color: #b8c9e6
  table
    width: 100%
    margin: 20px 0
    border: 1px solid rgba(116, 198, 255, 0.14)
    border-radius: 10px
    overflow: hidden
    border-collapse: collapse
  th
    color: #eef4fb
    background: rgba(116, 198, 255, 0.10)
    font-weight: 600
  td, th
    padding: 10px 12px
    border-bottom: 1px solid rgba(116, 198, 255, 0.1)
    text-align: left
  img
    max-width: 100%
    height: auto
    border-radius: 10px

