<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head') %>
<body class="page-layout-<%= page.layout || 'default' %>">
  <a class="skip-link" href="#content-outer">跳到正文</a>
  <canvas id="starfield" aria-hidden="true"></canvas>
  <div class="cursor-halo" aria-hidden="true"></div>
  <div class="cosmic-background" aria-hidden="true">
    <span class="cosmic-orbit orbit-alpha"></span>
    <span class="cosmic-orbit orbit-beta"></span>
    <span class="cosmic-orbit orbit-gamma"></span>
  </div>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', null, {cache: !config.relative_link}) %>
      <div class="outer" id="content-outer">
        <section id="main"><%- body %></section>
        <% if (theme.sidebar && theme.sidebar !== 'bottom' && page.layout !== 'post'){ %>
          <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
        <% } %>
      </div>
      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </div>
    <%- partial('_partial/mobile-nav', null, {cache: !config.relative_link}) %>
    <%- partial('_partial/after-footer') %>
  </div>
</body>
</html>
