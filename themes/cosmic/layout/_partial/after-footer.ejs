<% if (theme.disqus_shortname){ %>
<script defer>
  window.addEventListener('load', function() {
    var disqus_shortname = '<%= theme.disqus_shortname %>';
    <% if (page.permalink){ %>
    var disqus_url = '<%= page.permalink %>';
    <% } %>
    (function(){
      var dsq = document.createElement('script');
      dsq.async = true;
      dsq.src = 'https://' + disqus_shortname + '.disqus.com/<% if (page.comments) { %>embed.js<% } else { %>count.js<% } %>';
      (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
    })();
  });
</script>
<% } %>

<!-- 音乐播放器容器（id 不用 "aplayer"：那会在 window 上创建同名全局引用，与脚本判断冲突） -->
<div id="music-player-host"></div>

<%- js('js/jquery-3.6.4.min.js') %>

<!-- APlayer 音乐播放器脚本 -->
<%- js('https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js') %>

<% if (theme.fancybox){ %>
  <% /* js() 助手不接受选项对象（会渲染成第二个 404 资源），手写标签 */ %>
  <script defer src="<%= url_for('fancybox/jquery.fancybox.min.js') %>"></script>
<% } %>

<% /* asset_version(path) 按文件内容哈希 —— 只有真正改过的文件才换 URL */ %>
<script src="<%= url_for('js/script.js') %>?v=<%= asset_version('js/script.js') %>"></script>
<script src="<%= url_for('js/likes.js') %>?v=<%= asset_version('js/likes.js') %>"></script>
<script src="<%= url_for('js/music-player.js') %>?v=<%= asset_version('js/music-player.js') %>"></script>
<script src="<%= url_for('js/cosmic.js') %>?v=<%= asset_version('js/cosmic.js') %>"></script>
<script src="<%= url_for('js/pjax.js') %>?v=<%= asset_version('js/pjax.js') %>"></script>
<%- partial('gauges-analytics') %>

<% /* Waline：serverURL 未配置时完全不加载，站点照常工作 */ %>
<% if (theme.waline && theme.waline.serverURL){ %>
<script>
  window.__WALINE_CONFIG__ = {
    serverURL: <%- JSON.stringify(theme.waline.serverURL) %>,
    lang: <%- JSON.stringify(theme.waline.lang || 'zh-CN') %>,
    placeholder: <%- JSON.stringify(theme.waline.placeholder || '') %>,
    requiredMeta: <%- JSON.stringify(theme.waline.requiredMeta || '') %>,
    pageSize: <%- JSON.stringify(theme.waline.pageSize || 10) %>,
    reaction: <%- JSON.stringify(theme.waline.reaction !== false) %>,
    commentCount: <%- JSON.stringify(theme.waline.commentCount !== false) %>,
    pageview: <%- JSON.stringify(theme.waline.pageview !== false) %>
  };
</script>
<script type="module" src="<%= url_for('js/waline-init.js') %>?v=<%= asset_version('js/waline-init.js') %>"></script>
<% } %>