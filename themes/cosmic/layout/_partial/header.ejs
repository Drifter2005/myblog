<header id="header">
  <div class="cosmic-grid" aria-hidden="true"></div>
  <div class="cosmic-scanline" aria-hidden="true"></div>
  <div id="banner"></div>
  <div id="header-outer" class="outer">
    <div id="header-title" class="inner">
      <div class="hero-kicker">ALGORITHM / CTF / SECURITY RESEARCH</div>
      <h1 id="logo-wrap">
        <a href="<%- url_for() %>" id="logo"><%= config.title %></a>
      </h1>
      <% if (theme.subtitle || config.subtitle){ %>
        <%# 副标题不是标题层级，用 p 承载 %>
        <p id="subtitle-wrap">
          <a href="<%- url_for() %>" id="subtitle"><%= theme.subtitle || config.subtitle %></a>
        </p>
      <% } %>
      <div class="hero-metrics" aria-label="research focus">
        <span>Graph Theory</span>
        <span>Crypto</span>
        <span>Reverse</span>
        <span>Pwn</span>
      </div>
    </div>
    <div id="header-inner" class="inner">
      <nav id="main-nav" aria-label="主导航">
        <button id="main-nav-toggle" class="nav-icon" type="button" aria-label="打开导航菜单" aria-expanded="false" aria-controls="mobile-nav"><span class="fa fa-bars" aria-hidden="true"></span></button>
        <% for (var i in theme.menu){ %>
          <a class="main-nav-link" href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
        <% } %>
      </nav>
      <nav id="sub-nav" aria-label="外部链接与搜索">
        <% if (theme.links) { %>
          <% for (const i in theme.links) {%>
            <a class="nav-icon" href="<%- url_for(theme.links[i]) %>" aria-label="<%= i %>"><span class="fa fa-<%= i %>" aria-hidden="true"></span></a>
          <% } %>
        <% } %>
        <% if (theme.rss){ %>
          <a class="nav-icon" href="<%- url_for(theme.rss) %>" title="<%= __('rss_feed') %>"><span class="fa fa-rss" aria-hidden="true"></span></a>
        <% } %>
        <button class="nav-icon nav-search-btn" type="button" aria-label="<%= __('search') %>" aria-expanded="false"><span class="fa fa-search" aria-hidden="true"></span></button>
      </nav>
      <div id="search-form-wrap">
        <form action="//google.com/search" method="get" accept-charset="UTF-8" class="search-form" role="search">
          <label class="sr-only" for="site-search-input"><%= __('search') %></label>
          <input type="search" id="site-search-input" name="q" class="search-form-input" placeholder="<%= __('search') %>">
          <button type="submit" class="search-form-submit" aria-label="<%= __('search') %>"><span class="fa fa-search" aria-hidden="true"></span></button>
          <input type="hidden" name="sitesearch" value="<%= config.url %>">
        </form>
      </div>
    </div>
  </div>
</header>
