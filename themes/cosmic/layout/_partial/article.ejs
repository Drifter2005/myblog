<article id="<%= post.layout %>-<%= post.slug %>" class="h-entry article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <% if (!index){ %>
    <div class="article-meta">
      <span class="article-signal">OBSERVATION</span>
      <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
    </div>
  <% } %>
  <div class="article-inner">
    <%- partial('post/gallery') %>
    <% if (index){ %>
      <% var previewText = strip_html(post.excerpt || post.content); %>
      <div class="article-summary">
        <div class="article-meta">
          <span class="article-signal">OBSERVATION</span>
          <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
          <%- partial('post/category') %>
        </div>
        <% if (post.link || post.title){ %>
          <header class="article-header">
            <%# 列表页文章标题用 h2：页面唯一的 h1 留给站点/页面主标题 %>
            <h2 class="p-name article-title">
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h2>
          </header>
        <% } %>
        <div class="article-entry article-preview">
          <p><%= previewText.slice(0, 280) %><% if (previewText.length > 280){ %>...<% } %></p>
        </div>
        <p class="article-more-link">
          <a href="<%- url_for(post.path) %>">阅读全文</a>
        </p>
      </div>
    <% } else { %>
      <% if (post.link || post.title){ %>
        <header class="article-header">
          <%- partial('post/title', {class_name: 'p-name article-title'}) %>
        </header>
      <% } %>
      <div class="e-content article-entry" itemprop="articleBody">
        <%- post.content %>
      </div>
    <% } %>
    <%
      // Waline 用归一化后的 path 作为文章标识，必须与 waline-init.js 里的
      // normalizePath 结果一致，否则计数器和评论列表会对不上。
      var walineOn = theme.waline && theme.waline.serverURL;
      var walinePath = url_for(post.path).replace(/index\.html$/, '');
      if (walinePath.slice(-1) !== '/') walinePath += '/';
    %>
    <footer class="article-footer">
      <a data-url="<%- post.permalink %>" data-id="<%= post._id %>" data-title="<%= post.title %>" class="article-share-link"><span class="fa fa-share"><%= __('share') %></span></a>
      <%# 鼓掌式点赞：同一访客可以连续点多次，每次 +1 %>
      <button class="like-btn" type="button" data-post="<%- url_for(post.path) %>" title="点赞（可以点很多次）" aria-label="点赞此文章">
        <span class="like-icon" aria-hidden="true">❤️</span>
        <span class="like-count">0</span>
      </button>
      <% if (walineOn && theme.waline.pageview !== false){ %>
        <span class="article-metric" title="阅读量">
          <span class="fa fa-eye" aria-hidden="true"></span>
          <span class="waline-pageview-count" data-path="<%= walinePath %>">–</span>
        </span>
      <% } %>
      <% if (index && post.comments && walineOn && theme.waline.commentCount !== false){ %>
        <a href="<%- url_for(post.path) %>#comments" class="article-comment-link" title="评论数">
          <span class="fa fa-comment" aria-hidden="true"></span>
          <span class="waline-comment-count" data-path="<%= walinePath %>" itemprop="commentCount">–</span>
        </a>
      <% } %>
      <% if (index && post.comments && theme.disqus_shortname){ %>
        <a href="<%- post.permalink %>#disqus_thread" class="article-comment-link"><span class="fa fa-comment"><%= __('comment') %></span></a>
      <% } %>
      <%- partial('post/tag') %>
    </footer>
  </div>
  <% if (!index){ %>
    <%- partial('post/nav') %>
  <% } %>
</article>

<% if (!index && post.comments && theme.disqus_shortname){ %>
<section id="comments">
  <div id="disqus_thread">
    <noscript>Please enable JavaScript to view the <a href="//disqus.com/?ref_noscript">comments powered by Disqus.</a></noscript>
  </div>
</section>
<% } %>
<% if (!index && post.comments && theme.waline && theme.waline.serverURL){ %>
  <section id="comments" class="comment-section">
    <h2 class="comment-title">观测信号</h2>
    <%- partial('post/comment-noscript') %>
    <div id="waline"></div>
  </section>
<% } %>
